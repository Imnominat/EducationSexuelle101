  m_Script: {fileID: 11500000, guid: b8e880d14b140824a96a85045c40f62b, type: 3}
  m_Name: DDepister
  m_EditorClassIdentifier: Dialogs::Dialogs.DialogData
  DialogText: "Il est en effet important de se faire d\xE9pister. Le d\xE9pistage
    peut se faire au domicile, en laboratoire, chez un professionnel de sant\xE9
    ou dans une structure sp\xE9cialis\xE9e (CeGIDD, centre de sant\xE9 sexuelle...).
    En laboratoire, le d\xE9pistage est sans ordonnance et sans rendez-vous. Il recherche
    VIH, h\xE9patite B, syphilis, gonocoque et chlamydia. Si vous avez moins de 26
    ans, il est pris en charge \xE0 100%. Si vous avez plus de 26 ans, seul le d\xE9pistage
    du VIH est pris en charge \xE0 100% (prise en charge de 60% par l'Assurance Maladie
    et de 40% par la mutuelle pour les autres maladies sexuellement transmissibles).  "
  DialogAudioClip: {fileID: 0}
  DialogIcon: {fileID: 0}
