  m_Script: {fileID: 11500000, guid: 86ac1fa31801f4e41806a85e05a2a200, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnalysableObject
  objectTitle: Scrotum
  objectDescription: "Le scrotum est une poche de peau situ\xE9e sous le p\xE9nis,
    qui contient et prot\xE8ge les testicules et aide \xE0 maintenir leur temp\xE9rature
    id\xE9ale pour la production des spermatozo\xEFdes. Il n'y a pas de taille pr\xE9cise
    car il s'agit d'une enveloppe de peau variable. La peau du p\xE9nis est distincte
    : elle prolonge la peau du scrotum \xE0 sa base, mais recouvre uniquement le
    corps du p\xE9nis et le gland."
