  m_Script: {fileID: 11500000, guid: 86ac1fa31801f4e41806a85e05a2a200, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnalysableObject
  objectTitle: Vessie
  objectDescription: "La vessie est l'organe du syst\xE8me urinaire dont la fonction
    est de recevoir l'urine terminale produite par les reins puis de la conserver
    avant son \xE9vacuation au cours de la miction. L'urine arrive dans la vessie
    par les uret\xE8res et est \xE9mise via l'ur\xE8tre."
--- !u!114 &2278130553157606380
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2278130553157606376}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86ac1fa31801f4e41806a85e05a2a200, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnalysableObject
  objectTitle: "Ut\xE9rus"
  objectDescription: "L'ut\xE9rus est l'organe musculaire o\xF9 se d\xE9veloppe le
    f\u0153tus. Sa partie inf\xE9rieure se r\xE9tr\xE9cit pour former le col de l'ut\xE9rus,
    une fronti\xE8re physique reliant l'ut\xE9rus au vagin et agissant comme un verrou
    protecteur. En haut, la cavit\xE9 ut\xE9rine s'ouvre sur les deux trompes de
    Fallope, qui capturent l'ovule et permettent sa rencontre avec les spermatozo\xEFdes. "
--- !u!114 &2278130553157606381
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
