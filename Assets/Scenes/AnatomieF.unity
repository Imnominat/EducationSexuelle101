  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnalysableObject
  objectTitle: Vagin
  objectDescription: "Le vagin est un organe tubulaire musculo-muqueux faisant partie
    du syst\xE8me reproducteur femelle. Il relie la vulve \xE0 l'ut\xE9rus."
