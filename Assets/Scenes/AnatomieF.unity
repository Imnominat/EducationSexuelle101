  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 86ac1fa31801f4e41806a85e05a2a200, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnalysableObject
  objectTitle: Clitoris
  objectDescription: "Le clitoris est l'organe du plaisir sexuel, compos\xE9 d'une
    partie visible (le gland) et de structures internes (les bulbes). Ces tissus
    \xE9rectiles entourent le vestibule, la zone centrale de la vulve. Lors de l'excitation,
    ils s'engorgent de sang, gonflent et sensibilisent toute cette r\xE9gion o\xF9
    s'ouvrent \xE9galement l'ur\xE8tre et le vagin."
